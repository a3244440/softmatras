---
import CategoryPage from '../components/CategoryPage.astro';
const faq = [
  { q: 'Зачем нужен топпер?', a: 'Топпер это тонкий матрас 3-7 см, который кладут поверх матраса или дивана. Он выравнивает поверхность, меняет жёсткость спального места и продлевает жизнь основному матрасу.' },
  { q: 'Какой топпер выбрать на диван?', a: 'Чтобы скрыть стыки и неровности дивана, подойдут FoamCloud 4 см или топпер из койры и ППУ 5 см. Если диван слишком мягкий, берите топпер с кокосовой койрой.' },
  { q: 'Какой топпер сделает матрас мягче?', a: 'Memory Foam 6 см, латексный SnowCloud 4 см или мягкая сторона CocoMemory и Natural Duo.' },
  { q: 'Есть ли топперы нестандартного размера?', a: 'Стандартные размеры от 80×200 до 200×220. Другой размер можно сделать на заказ, уточните в WhatsApp.' },
];
const seo = `<h2>Топперы на матрас и диван от фабрики</h2><p>Топпер решает три задачи: выравнивает продавленный диван или старый матрас, меняет жёсткость спального места и защищает основной матрас от износа. Мягкие модели делают из пены с эффектом памяти и натурального латекса, жёсткие из кокосовой койры, а двусторонние совмещают обе стороны.</p><p>Все топперы Softmatras есть в размерах от 80×200 до 200×220 см и доставляются бесплатно по Алматы и Астане.</p>`;
---
<CategoryPage cat="topper" path="/toppery/" title="Топперы на матрас и диван в Алматы и Астане: цены от 15 900 ₸ | Softmatras" description="Топперы Softmatras 3-7 см: кокосовая койра, Memory Foam, латекс, двусторонние. Размеры от 80×200 до 200×220, бесплатная доставка по Алматы и Астане." keywords="топпер купить Алматы, топпер на диван Астана, топпер на матрас, топпер memory foam, топпер кокос" faq={faq} seo={seo} />
