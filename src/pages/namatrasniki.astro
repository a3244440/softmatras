---
import CategoryPage from '../components/CategoryPage.astro';
const faq = [
  { q: 'Зачем нужен наматрасник?', a: 'Он защищает матрас от пыли, пятен и пота и продлевает ему срок службы. Наматрасник легко снять и постирать, а матрас нет.' },
  { q: 'Какой наматрасник выбрать для ребёнка?', a: 'Водонепроницаемый: мембрана 100% не пропускает жидкость, а махровый хлопок сверху мягкий и гипоаллергенный.' },
  { q: 'Как подобрать размер?', a: 'Берите наматрасник того же размера, что и матрас: от 80×200 до 200×220 см.' },
];
const seo = `<h2>Наматрасники для защиты матраса</h2><p>Гигиенический наматрасник из хлопковой бязи защищает матрас от пыли и загрязнений и делает сон комфортнее. Водонепроницаемый с мембраной подходит для детской, для пожилых людей и для всех, кто хочет защитить матрас от случайно пролитой жидкости.</p>`;
---
<CategoryPage cat="namatrasnik" path="/namatrasniki/" title="Наматрасники в Алматы и Астане: водонепроницаемые и гигиенические от 6 990 ₸ | Softmatras" description="Гигиенический наматрасник из хлопка и водонепроницаемый с мембраной. Размеры от 80×200 до 200×220, доставка по Алматы и Астане." keywords="наматрасник купить Алматы, водонепроницаемый наматрасник Астана, наматрасник 160х200" faq={faq} seo={seo} />
