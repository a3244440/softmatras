---
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import Contacts from '../components/Contacts.astro';
import Icon from '../components/Icon.astro';
import { REVIEWS, waLink } from '../data/site';
import { faqSchema } from '../lib/schema';

const steps = [
  { t: 'Пришлите размеры', d: 'Измерьте кровать по внутреннему краю рамы и отправьте нам в WhatsApp. Подойдёт и фото кровати с рулеткой.' },
  { t: 'Подберём модель', d: 'Консультант уточнит вес, позу сна и пожелания по жёсткости, посчитает цену.' },
  { t: 'Сошьём на фабрике', d: 'Обычно за несколько дней. Матрас делается под ваш размер, без компромиссов.' },
  { t: 'Привезём и поднимем', d: 'Бесплатно по Алматы и Астане, заберём старый матрас. В другие города отправим.' },
];
const faq = [
  { q: 'Сколько стоит матрас нестандартного размера?', a: 'Цену считаем по ближайшему стандартному размеру выбранной модели и площади матраса. Пришлите размеры в WhatsApp, ответим с точной суммой.' },
  { q: 'За сколько дней сделаете матрас на заказ?', a: 'Обычно за несколько дней, точный срок зависит от модели и загрузки производства. Покупатели в отзывах отмечают, что матрас сшили «за короткий срок».' },
  { q: 'Можно ли сделать матрас длиннее 200 см?', a: 'Да. Например, мы шили матрас 160×230 для подростка ростом 192 см. Длина и ширина любые.' },
  { q: 'Делаете ли кровати на заказ?', a: 'Да, кроме матрасов мы изготавливаем кровати по индивидуальному размеру, уточняйте у консультанта.' },
];
const custom = REVIEWS.filter((r) => /заказ|размер|1\.60|индивидуал|параметр/i.test(r.text)).slice(0, 4);
---
<Base
  title="Матрасы на заказ в Алматы и Астане: любой размер от фабрики | Softmatras"
  description="Матрас на заказ по вашим размерам в Алматы и Астане: нестандартные 160×230, 150×190, под любую кровать. Собственное производство, изготовление за несколько дней, доставка бесплатно."
  keywords="матрасы на заказ Астана, матрасы на заказ Алматы, матрас нестандартного размера, матрас по размеру кровати"
  crumbs={[{ name: 'Главная', href: '/' }, { name: 'Матрасы на заказ', href: '/matrasy-na-zakaz/' }]}
  schema={[faqSchema(faq), { '@type': 'Service', name: 'Изготовление матрасов на заказ', provider: { '@id': 'https://softmatras.kz/#org' }, areaServed: ['Алматы', 'Астана', 'Казахстан'], serviceType: 'Матрасы нестандартного размера' }]}
>
  <section class="page-hero wrap">
    <h1 class="page-h">Матрасы на заказ любого размера</h1>
    <p class="page-lead">Своя фабрика в Казахстане: шьём матрас под вашу кровать, а не подгоняем кровать под матрас. Алматы, Астана и доставка по Казахстану.</p>
    <div class="page-cta"><a class="btn btn--pink" href={waLink('Здравствуйте! Нужен матрас нестандартного размера: ')} target="_blank" rel="noopener"><Icon name="wa" /> Отправить размеры</a></div>
  </section>
  <section class="sec sec--tight">
    <div class="wrap">
      <ol class="steps" role="list">
        {steps.map((s, i) => <li><span class="sec-num">({String(i + 1).padStart(2, '0')})</span><h2>{s.t}</h2><p>{s.d}</p></li>)}
      </ol>
    </div>
  </section>
  <section class="sec sec--tight">
    <div class="wrap">
      <h2 class="h2">Уже заказывали у нас</h2>
      <ul class="cards" role="list">{custom.map((r) => <li class="card"><p style="color:inherit">{r.text}</p><b>{r.name}</b><span style="color:var(--ink-3);font-size:14px">{r.date}, 2ГИС</span></li>)}</ul>
    </div>
  </section>
  <section class="sec sec--tight"><div class="wrap"><h2 class="h2">Вопросы</h2><Faq items={faq} /></div></section>
  <section class="sec sec--tight"><div class="wrap"><Contacts /></div></section>
</Base>
<style>
  .steps { list-style: none; padding: 0; margin: 0; display: grid; gap: 0; border-top: 1.5px solid var(--ink); }
  @media (min-width: 900px) { .steps { grid-template-columns: repeat(4, 1fr); column-gap: 32px; } }
  .steps li { padding: 24px 0 28px; border-bottom: 1px solid var(--line); }
  .steps .sec-num { margin-bottom: 14px; }
  .steps h2 { font-size: clamp(24px, 2.4vw, 30px); letter-spacing: -0.035em; margin-bottom: 8px; }
  .steps p { color: var(--ink-2); }
</style>
