---
import { SITE } from '../data/site';
const nav = [
  { href: '/katalog/', t: 'Каталог' },
  { href: '/almaty/', t: 'Алматы' },
  { href: '/astana/', t: 'Астана' },
  { href: '/matrasy-na-zakaz/', t: 'На заказ' },
  { href: '/otzyvy/', t: 'Отзывы' },
  { href: '/kontakty/', t: 'Контакты' },
];
const path = Astro.url.pathname;
---
<header class="hd">
  <div class="hd-in wrap">
    <a href="/" class="logo" aria-label="Softmatras, на главную"><b>soft</b><i>/</i><span>matras</span></a>
    <nav class="hd-nav" aria-label="Основное меню">
      {nav.map((n) => <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.t}</a>)}
    </nav>
    <a class="hd-tel" href={`tel:${SITE.phone}`}>{SITE.phoneHuman}</a>
    <button class="burger" aria-expanded="false" aria-controls="menu" aria-label="Открыть меню"><span></span><span></span><span></span></button>
  </div>
  <div class="menu" id="menu" hidden>
    <nav class="wrap" aria-label="Мобильное меню">
      {nav.map((n) => <a href={n.href}>{n.t}</a>)}
      <a href="/dostavka-i-oplata/">Доставка и оплата</a>
      <a href="/sovety/">Как выбрать матрас</a>
      <div class="menu-cta">
        <a class="btn btn--pink" href={`https://wa.me/${SITE.whatsapp}`}>Написать в WhatsApp</a>
        <a class="btn btn--light" href={`tel:${SITE.phone}`}>{SITE.phoneHuman}</a>
      </div>
    </nav>
  </div>
</header>

<style>
  .hd { position: sticky; top: 0; z-index: 50; background: color-mix(in srgb, var(--bg) 88%, transparent); backdrop-filter: saturate(1.4) blur(14px); -webkit-backdrop-filter: saturate(1.4) blur(14px); }
  .hd-in { display: flex; align-items: center; gap: 28px; height: 76px; }
  .logo { font-size: 27px; letter-spacing: -0.045em; text-decoration: none; display: inline-flex; align-items: baseline; line-height: 1; margin-right: auto; }
  .logo b { font-weight: 700; }
  .logo i { font-style: normal; font-weight: 300; margin: 0 2px; color: var(--pink); }
  .logo span { font-weight: 350; }
  .hd-nav { display: none; gap: 26px; font-size: 16px; font-weight: 500; }
  .hd-nav a { text-decoration: none; padding: 6px 0; position: relative; }
  .hd-nav a[aria-current] { color: var(--pink-ink); }
  .hd-tel { display: none; font-weight: 600; text-decoration: none; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .burger { width: 92px; height: 56px; border-radius: var(--r-pill); background: var(--ink); border: 0; display: grid; place-content: center; gap: 5px; cursor: pointer; transition: transform 160ms var(--ease-out); }
  .burger:active { transform: scale(0.96); }
  .burger span { display: block; width: 30px; height: 1.5px; background: #fff; transition: transform 260ms var(--ease-out), opacity 200ms; }
  .burger[aria-expanded='true'] span:nth-child(1) { transform: translateY(6.5px) rotate(45deg); }
  .burger[aria-expanded='true'] span:nth-child(2) { opacity: 0; }
  .burger[aria-expanded='true'] span:nth-child(3) { transform: translateY(-6.5px) rotate(-45deg); }
  .menu { position: fixed; inset: 76px 0 0; background: var(--bg); overflow: auto; padding: 24px 0 40px; }
  .menu nav { display: flex; flex-direction: column; }
  .menu nav > a { font-size: clamp(30px, 8vw, 44px); font-weight: 600; letter-spacing: -0.04em; text-decoration: none; padding: 8px 0; }
  .menu-cta { display: grid; gap: 10px; margin-top: 28px; }
  .menu:not([hidden]) { animation: mIn 280ms var(--ease-out); }
  @keyframes mIn { from { opacity: 0; transform: translateY(-8px); } }
  @media (min-width: 1080px) {
    .hd-nav, .hd-tel { display: flex; }
    .burger { width: 76px; height: 48px; }
  }
  @media (prefers-reduced-motion: reduce) { .menu:not([hidden]) { animation: none; } }
</style>

<script>
  const b = document.querySelector<HTMLButtonElement>('.burger')!;
  const m = document.getElementById('menu')!;
  const set = (open: boolean) => { b.setAttribute('aria-expanded', String(open)); m.hidden = !open; document.body.style.overflow = open ? 'hidden' : ''; b.setAttribute('aria-label', open ? 'Закрыть меню' : 'Открыть меню'); };
  b.addEventListener('click', () => set(m.hidden));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !m.hidden) set(false); });
</script>
