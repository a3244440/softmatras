---
import { REVIEWS, SITE } from '../data/site';
import Icon from './Icon.astro';
interface Props { limit?: number; showHead?: boolean; }
const { limit = 9, showHead = true } = Astro.props;
const list = REVIEWS.slice(0, limit);
const initials = (n: string) => n.replace(/[^\p{L}\s]/gu, '').trim().split(/\s+/).slice(0, 2).map((w) => w[0]).join('').toUpperCase() || '★';
---
{showHead && (
  <div class="rv-head">
    <a class="rating" href={SITE.twoGisReviews} target="_blank" rel="noopener">
      <span class="rating-n">{String(SITE.rating).replace('.', ',')}</span>
      <span class="rating-meta">
        <span class="stars" aria-hidden="true">{[1,2,3,4,5].map(() => <Icon name="star" />)}</span>
        <span>{SITE.ratingCount} оценок в 2ГИС</span>
      </span>
    </a>
    <p class="rv-src">Отзывы перенесены из 2ГИС без правок, с оригинальной орфографией, на русском и казахском.</p>
  </div>
)}
<ul class="revs" role="list">
  {list.map((r) => (
    <li class="rev" lang={r.lang === 'kk' ? 'kk' : 'ru'}>
      <figure>
        {r.tag && <span class="tag">{r.tag}</span>}
        <blockquote><p>{r.text}</p></blockquote>
        <figcaption>
          <span class="av" aria-hidden="true">{initials(r.name)}</span>
          <span><b>{r.name}</b><time datetime={r.iso}>{r.date}, 2ГИС</time></span>
        </figcaption>
      </figure>
    </li>
  ))}
</ul>
<style>
  .rv-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 18px 40px; margin-bottom: 32px; }
  .rating { display: inline-flex; align-items: center; gap: 16px; text-decoration: none; }
  .rating-n { font-size: clamp(56px, 7vw, 88px); font-weight: 600; letter-spacing: -0.05em; line-height: 1; }
  .rating-meta { display: grid; gap: 4px; font-size: 15px; color: var(--ink-2); }
  .stars { display: flex; gap: 2px; color: var(--pink); }
  .stars :global(svg) { width: 20px; height: 20px; }
  .rv-src { color: var(--ink-2); font-size: 15px; max-width: 420px; }
  .revs { list-style: none; margin: 0; padding: 0; columns: 1; column-gap: 16px; }
  @media (min-width: 720px) { .revs { columns: 2; } }
  @media (min-width: 1100px) { .revs { columns: 3; } }
  .rev { break-inside: avoid; margin-bottom: 16px; }
  .rev figure { margin: 0; background: var(--paper); border-radius: var(--r-md); padding: 24px; display: grid; gap: 14px; }
  .rev blockquote { margin: 0; font-size: 16.5px; line-height: 1.55; }
  .rev .tag { justify-self: start; }
  figcaption { display: flex; align-items: center; gap: 12px; font-size: 14px; }
  figcaption b { display: block; font-weight: 600; font-size: 15px; }
  figcaption time { color: var(--ink-3); }
  .av { width: 40px; height: 40px; border-radius: 50%; background: var(--bg); display: grid; place-items: center; font-weight: 600; font-size: 14px; flex: none; }
</style>
